<?xml version="1.0" encoding="UTF-8"?><project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.kuaishou.infra.boot</groupId>
    <artifactId>ks-boot-root-pom</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath/>
  </parent>
  <groupId>kuaishou</groupId>
  <artifactId>agentkopbackend</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>${project.artifactId}</name>
  <description>${project.name}</description>
  <!-- FIXME git 地址请生成后自行填写 -->
  <scm>
    <connection>scm:git:</connection>
    <developerConnection>scm:git:</developerConnection>
    <url/>
    <tag>HEAD</tag>
  </scm>
  <properties>
    <!-- 当前工程版本号 -->
    <revision>1.0.0-SNAPSHOT</revision>
    <agentk-sdk.version>0.3.6</agentk-sdk.version>
    <agentk-ksboot.version>0.3.6</agentk-ksboot.version>
    <!-- agent-k gRPC SDK 要求 JDK 11+；覆盖 ks-boot 默认的 Java 8 -->
    <java.version>11</java.version>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <maven.compiler.release>11</maven.compiler.release>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.kuaishou.klingai.agentk</groupId>
        <artifactId>agentk-client-ksboot</artifactId>
        <version>${agentk-ksboot.version}</version>
      </dependency>
      <dependency>
        <groupId>com.kuaishou.klingai.agentk</groupId>
        <artifactId>agentk-client</artifactId>
        <version>${agentk-sdk.version}</version>
      </dependency>
      <dependency>
        <groupId>com.kuaishou.klingai.agentk</groupId>
        <artifactId>agentk-protocol</artifactId>
        <version>${agentk-sdk.version}</version>
      </dependency>
      <dependency>
        <groupId>kuaishou</groupId>
        <artifactId>agent-operation-backend-component</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>kuaishou</groupId>
        <artifactId>agent-operation-backend-sdk</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>com.mysql</groupId>
        <artifactId>mysql-connector-j</artifactId>
        <version>8.0.33</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <profiles>
    <profile>
      <id>dev</id>
      <properties>
        <!-- 用于替换 application.yml 中的变量 -->
        <mvn.profile.active>dev</mvn.profile.active>
      </properties>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <modules>
        <module>agent-operation-backend-sdk</module>
        <module>agent-operation-backend-component</module>
        <module>agent-operation-backend-api</module>
        <module>agent-operation-backend-runner</module>
      </modules>
    </profile>
    <profile>
      <id>test</id>
      <modules>
        <module>agent-operation-backend-sdk</module>
        <module>agent-operation-backend-component</module>
        <module>agent-operation-backend-api</module>
        <module>agent-operation-backend-runner</module>
      </modules>
      <properties>
        <!-- 用于替换 application.yml 中的变量 -->
        <mvn.profile.active>test</mvn.profile.active>
      </properties>
    </profile>
    <profile>
      <id>prod</id>
      <modules>
        <module>agent-operation-backend-sdk</module>
        <module>agent-operation-backend-component</module>
        <module>agent-operation-backend-api</module>
        <module>agent-operation-backend-runner</module>
      </modules>
      <properties>
        <!-- 用于替换 application.yml 中的变量 -->
        <mvn.profile.active>prod</mvn.profile.active>
      </properties>
    </profile>
    <profile>
      <id>release-sdk</id>
      <modules>
        <module>agent-operation-backend-sdk</module>
      </modules>
    </profile>
  </profiles>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>11</release>
        </configuration>
      </plugin>
      <!-- 仅在需要发布到 nexus 中的模块中开启 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
      <!-- 关闭 checkstyle 校验，请用户自行决定是否要开启 checkstyle -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <executions>
          <execution>
            <id>validate</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <!-- FIXME 下面的 <modules></modules> 标签内的内容请删除，该内容为 Maven 自动生成，无法控制 -->
  <modules>
    <module>agent-operation-backend-api</module>
    <module>agent-operation-backend-component</module>
    <module>agent-operation-backend-runner</module>
    <module>agent-operation-backend-sdk</module>
  </modules>
</project>
