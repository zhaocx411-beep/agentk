FROM docker.io/library/maven:3.9.11-eclipse-temurin-17 AS build

WORKDIR /src
COPY java/apiserver/pom.xml ./pom.xml
COPY java/apiserver/src ./src
RUN mvn -B package -DskipTests

FROM docker.io/library/eclipse-temurin:17-jre

WORKDIR /app
ENV API_HOST=0.0.0.0 \
    API_PORT=8080 \
    PROFILE_FILE=/app/profile.json

COPY --from=build /src/target/storyboard-example-java-apiserver-0.1.0-SNAPSHOT.jar ./app.jar
COPY --from=build /src/target/lib ./lib
COPY java/apiserver/profile.json ./profile.json

EXPOSE 8080
ENTRYPOINT ["java", "-Dcom.google.protobuf.use_unsafe_pre22_gencode=true", "-cp", "app.jar:lib/*", "com.kuaishou.klingai.agentk.storyboard.apiserver.Main"]
