FROM docker.io/library/python:3.13-slim-bookworm AS build

COPY --from=ghcr.io/astral-sh/uv:0.11.8 /uv /uvx /bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libsnappy-dev \
    && rm -rf /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /app/python

COPY python/pyproject.toml python/uv.lock ./
COPY python/worker/pyproject.toml worker/pyproject.toml
COPY python/mcp-server/pyproject.toml mcp-server/pyproject.toml
RUN uv sync \
    --locked \
    --no-dev \
    --package storyboard-example-worker

FROM docker.io/library/python:3.13-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends libsnappy1v5 \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app/python/worker

COPY --from=build /opt/venv /opt/venv
COPY --chown=65532:65532 \
    python/worker/abi.py \
    python/worker/workflow.py \
    python/worker/worker.py \
    ./

USER 65532:65532

ENTRYPOINT ["python", "worker.py"]
