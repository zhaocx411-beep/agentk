FROM docker.io/library/python:3.13-slim AS python-build

COPY --from=ghcr.io/astral-sh/uv:0.11.8 /uv /uvx /bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libsnappy-dev \
    && rm -rf /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /app/python

COPY python/pyproject.toml python/uv.lock ./
COPY python/worker/pyproject.toml worker/pyproject.toml
COPY python/mcp-server/pyproject.toml mcp-server/pyproject.toml
RUN uv sync \
    --locked \
    --no-dev \
    --package storyboard-example-mcp-server

FROM docker.io/library/python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends libsnappy1v5 \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8000

WORKDIR /app/python/mcp-server

COPY --from=python-build /opt/venv /opt/venv
COPY --chown=65532:65532 python/mcp-server/main.py ./
COPY --chown=65532:65532 \
    python/mcp-server/ui/storyboard-film.html \
    /app/python/mcp-server/ui/storyboard-film.html
COPY --chown=65532:65532 \
    python/mcp-server/profile.json \
    /app/python/mcp-server/profile.json

USER 65532:65532

EXPOSE 8000

ENTRYPOINT ["python", "main.py"]
