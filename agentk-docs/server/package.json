{
  "name": "@agentk/docs-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/*.test.js",
    "test:search": "pnpm build && node --test dist/documents.test.js dist/tokenize.test.js dist/search.test.js dist/integration.test.js",
    "test:mcp": "pnpm build && node --test dist/repository.test.js dist/mcp.test.js dist/transports.test.js",
    "search": "node dist/cli.js",
    "mcp:stdio": "node dist/stdio.js",
    "mcp:http": "node dist/http.js",
    "inspect:mcp": "mcp-inspector node dist/stdio.js",
    "start:service": "node dist/service.js",
    "test:service": "pnpm build && node --test dist/ap-identity.test.js dist/auth.test.js dist/capabilities.test.js dist/config.test.js dist/kess.test.js dist/service.test.js dist/static.test.js"
  },
  "dependencies": {
    "@ks-cqc/ksap-identity-sdk": "1.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/server-legacy": "2.0.0",
    "compression": "1.8.1",
    "express": "4.22.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/inspector": "^2.3.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.2",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=24.0"
  }
}
