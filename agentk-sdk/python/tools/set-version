#!/usr/bin/env bash
set -euo pipefail

version="${1:?usage: tools/set-version VERSION}"
python_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "$python_root"
uv version --package ks-agentk-protocol "$version" --frozen
uv version --package ks-agentk-client "$version" --frozen
uv version --package ks-agentk-worker "$version" --frozen
uv add --package ks-agentk-client --raw "ks-agentk-protocol==$version" --frozen
uv lock
