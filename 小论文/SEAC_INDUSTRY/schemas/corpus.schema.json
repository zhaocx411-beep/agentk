{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/seac/corpus.schema.json",
  "title": "SEAC parsed corpus",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["file_name", "document_type", "blocks"],
    "additionalProperties": true,
    "properties": {
      "file_name": {"type": "string", "minLength": 1},
      "document_type": {"type": "string", "minLength": 1},
      "blocks": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["block_id", "block_type"],
          "additionalProperties": true,
          "properties": {
            "block_id": {"type": "string", "minLength": 1},
            "block_type": {"type": "string", "minLength": 1},
            "heading_path": {"type": "string"},
            "text": {"type": "string"},
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string"}
              }
            }
          },
          "anyOf": [
            {"required": ["text"]},
            {"required": ["rows"]}
          ]
        }
      }
    }
  }
}
